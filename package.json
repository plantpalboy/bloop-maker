{
  "name": "midiplayer",
  "version": "0.5.0",
  "type": "module",
  "description": "Bloop Maker — procedural video game music composer. No AI, runs offline.",
  "author": {
    "name": "SNCKPCK",
    "email": "contact@snckpck.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:demo": "cross-env VITE_DEMO=true vite",
    "build": "tsc && vite build",
    "build:demo": "tsc && cross-env VITE_DEMO=true vite build --outDir dist-demo",
    "build:site": "npm run build:demo && node scripts/build-site.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dev:electron": "concurrently -k -n VITE,ELECTRON -c green,cyan \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "pitchy": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.bloopmaker.app",
    "productName": "Bloop Maker",
    "artifactName": "Bloop-Maker-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Audio",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
